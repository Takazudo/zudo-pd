{
  "name": "zudo-pd",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "pnpm --dir .. circuit:prepare && run-p dev:zfb dev:history dev:circuit",
    "build": "zfb build",
    "preview": "zfb preview",
    "check": "zfb check",
    "check:html": "html-validate \"dist/**/*.html\"",
    "format:md": "pnpm --dir .. format:md",
    "format:md:check": "pnpm --dir .. format:md:check",
    "dev:zfb": "zfb dev",
    "dev:history": "doc-history-server --port 4322 --content-dir src/content/docs",
    "check:links": "node scripts/check-links.js",
    "dev:zfb:network": "zfb dev --host 0.0.0.0",
    "dev:network": "run-parallel dev:zfb:network dev:history",
    "dev:circuit": "pnpm --dir .. exec zudo-circuit-doc generate --watch --config circuit.config.ts"
  },
  "dependencies": {
    "@takazudo/zfb": "2.21.0",
    "@takazudo/zfb-runtime": "2.21.0",
    "@takazudo/zfb-adapter-cloudflare": "2.21.0",
    "@takazudo/zfb-md-wasm": "2.21.0",
    "@takazudo/zudo-doc": "5.27.0",
    "zod": "^4.3.6",
    "preact": "^10.29.1",
    "preact-render-to-string": "^6.6.6",
    "gray-matter": "^4.0.0",
    "mermaid": "11.15.0",
    "katex": "^0.16.38",
    "diff": "^8.0.3",
    "@takazudo/zudo-doc-history-server": "5.27.0",
    "mdast-util-to-markdown": "^2.1.2",
    "mdast-util-mdx": "^3.0.0",
    "mdast-util-gfm-table": "^2.0.0",
    "three": "0.185.1",
    "@takazudo/zdtp": "0.7.0",
    "@takazudo/zudo-circuit-doc": "^0.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.0",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/mdast": "^4.0.4",
    "html-validate": "^10.0.0",
    "lefthook": "^2.1.9",
    "@types/three": "0.185.3",
    "npm-run-all2": "^7.0.2"
  }
}
