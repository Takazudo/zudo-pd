{
  "name": "zudo-pd",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "pnpm --dir .. circuit:generate && run-p dev:zfb dev:history dev:circuit",
    "build": "zfb build",
    "preview": "zfb preview",
    "check": "zfb check",
    "check:html": "html-validate \"dist/**/*.html\"",
    "generate:components": "pnpm --dir .. circuit:generate",
    "check:components": "pnpm --dir .. check",
    "scan:components": "pnpm --dir .. check:site",
    "test:components": "node --experimental-strip-types --test \"component-docs/tests/*.test.ts\"",
    "dev:components": "pnpm dev:circuit",
    "generate:footprint-previews": "pnpm --dir .. previews:generate",
    "check:footprint-previews": "pnpm --dir .. previews:check",
    "generate:models": "pnpm --dir .. circuit:models",
    "check:models": "pnpm --dir .. check",
    "test:model-viewer:browser": "node ../circuit/scripts/model-viewer-browser-smoke.mjs",
    "check:built-component-references": "node scripts/check-built-component-references.mjs",
    "check:fragment-links": "node ../circuit/scripts/check-built-fragment-links.mjs",
    "b4push": "pnpm check && pnpm test:components && pnpm check:footprint-previews && pnpm check:models && pnpm build && pnpm check:built-component-references && pnpm check:fragment-links && pnpm check:components && pnpm scan:components",
    "format:md": "../scripts/mdx-format.sh --write \"src/content/docs/**/*.{md,mdx}\" --ignore \"node_modules/**,dist/**,build/**,.git/**,worktrees/**,src/content/docs/components/**\"",
    "format:md:check": "../scripts/mdx-format.sh --check \"src/content/docs/**/*.{md,mdx}\" --ignore \"node_modules/**,dist/**,build/**,.git/**,worktrees/**,src/content/docs/components/**\"",
    "dev:zfb": "zfb dev",
    "dev:history": "doc-history-server --port 4322 --content-dir src/content/docs",
    "check:links": "node scripts/check-links.js",
    "dev:zfb:network": "zfb dev --host 0.0.0.0",
    "dev:network": "run-parallel dev:zfb:network dev:history",
    "dev:circuit": "zudo-circuit-doc generate --watch --config ../circuit.config.ts"
  },
  "dependencies": {
    "@takazudo/zfb": "2.21.0",
    "@takazudo/zfb-runtime": "2.21.0",
    "@takazudo/zfb-adapter-cloudflare": "2.21.0",
    "@takazudo/zfb-md-wasm": "2.21.0",
    "@takazudo/zudo-doc": "5.27.0",
    "zod": "^4.3.6",
    "preact": "^10.29.1",
    "preact-render-to-string": "^6.6.6",
    "gray-matter": "^4.0.0",
    "mermaid": "11.15.0",
    "katex": "^0.16.38",
    "diff": "^8.0.3",
    "@takazudo/zudo-doc-history-server": "5.27.0",
    "mdast-util-to-markdown": "^2.1.2",
    "mdast-util-mdx": "^3.0.0",
    "mdast-util-gfm-table": "^2.0.0",
    "three": "0.185.1",
    "@takazudo/zdtp": "0.7.0",
    "@takazudo/zudo-circuit-doc": "^0.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.0",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/mdast": "^4.0.4",
    "html-validate": "^10.0.0",
    "lefthook": "^2.1.9",
    "@types/three": "0.185.3",
    "npm-run-all2": "^7.0.2"
  }
}
