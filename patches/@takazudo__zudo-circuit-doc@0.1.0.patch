+            if (manifest.formatVersion !== 1 || !Array.isArray(manifest.packages)) fail("PUBLICATION_POLICY", "malformed preview hash proof");
+            const reviewed = new Map(model.packagePreviews.map(p => [p.packageId, p]));
+            if (manifest.packages.length !== reviewed.size) fail("PUBLICATION_POLICY", "preview hash proof package count mismatch");
