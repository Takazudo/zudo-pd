+                const canonical = await realpath(file);
+                const rel = relative(root, canonical);
+                if (isAbsolute(rel) || rel.startsWith("..") || (await lstat(file)).isSymbolicLink() || !(await lstat(file)).isFile()) fail("PATH_CONTAINMENT", "preview hash proof escapes canonical library");
+                const hash = createHash("sha256").update(await readFile(file)).digest("hex");
+                if (hash !== entry.canonicalInputSha256) fail("PUBLICATION_POLICY", "preview canonical hash proof mismatch");
