+            for (const entry of data.packages) entry.canonicalInputSha256 = "";
+            provenTarget = {...target, text: JSON.stringify(data)};
+        }
+        results.push(scanTargets([provenTarget], canaries));
+    }
+    return {canaries: canaries.length, filesScanned: results.reduce((n,r) => n+r.filesScanned,0), filesSkippedBinary: results.reduce((n,r) => n+r.filesSkippedBinary,0), hits: results.flatMap(r => r.hits)};
