+            for (const entry of manifest.packages) {
+                const descriptor = reviewed.get(entry.packageId);
+                if (!descriptor || seen.has(entry.packageId) || entry.footprintPath !== descriptor.footprintPath || entry.footprintName !== descriptor.footprintName || !/^[0-9a-f]{64}$/.test(entry.canonicalInputSha256)) fail("PUBLICATION_POLICY", "unreviewed preview hash proof");
