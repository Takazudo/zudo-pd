* p5_full_21 TPS54560 average-model loop gain (vendor SLVMCU2 AVG.LIB)
.include ../lib/tps54560_avg.lib
VIN vin 0 21.0
XU comp 0 sw vin fb TPS54560_AVG PARAMS: L=10u FS=557k
L1 sw rawl 10u
RL1 rawl raw 68m
CO raw rco 1.1016e-05
RCO rco 0 0.0015
RFT raw fbd 54900.0
RFB fbd 0 10k
Vinj fb fbd DC 0 AC 1
RJ fbd vj 1meg
VJ vj 0 0.8
RCP comp cz 4020.0
CCP cz 0 2.7e-08
CHF comp 0 1.5e-10
LF raw prel 10u
RLF prel pre 68m
CF1 pre cf1 47u
RCF1 cf1 0 30m
CF2 pre cf2 5.508u
RCF2 cf2 0 3m
RLOAD pre 0 10.168

.control
op
print v(pre) v(raw) v(comp)
ac dec 50 100 1meg
let t = -v(fbd)/v(fb)
wrdata p5_full_21.dat t
.endc
.end
