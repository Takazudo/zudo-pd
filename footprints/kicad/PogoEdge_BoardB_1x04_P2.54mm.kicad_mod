(module PogoEdge_BoardB_1x04_P2.54mm (layer F.Cu) (tedit 65F0A000)
	(descr "Board B ATT/PDOK/GND/NC edge pogo contacts, 2.54 mm pitch and 1.5 x 2.5 mm exposed F.Cu. Bare copper only: no paste, model or physical component. Local -Y faces the board edge; center 1.8 mm inward leaves 0.55 mm copper clearance. Courtyard follows physical pads, allowing the three intermediate-rail contacts to continue the same row. Not a plated edge or a rated power connector.")
	(tags "pogo edge test ATT PDOK ground bare copper")
	(attr smd exclude_from_pos_files exclude_from_bom)
