(module PogoEdge_1x01_1.5x2.5mm (layer F.Cu) (tedit 65F0A000)
	(descr "Single bare-copper edge pogo contact, matching PogoPad_1x04_P2.54mm: 1.5 x 2.5 mm exposed F.Cu, no paste and no physical component. Place contacts on 2.54 mm centers; local -Y faces the board edge. A center 1.8 mm from the edge leaves 0.55 mm copper clearance. Use a separately connected GND contact as probe return; this is not a plated edge or a rated power connector.")
	(tags "pogo edge test probe bare copper")
	(attr smd exclude_from_pos_files exclude_from_bom)
	(fp_text reference REF** (at 0 2.2) (layer F.SilkS)
		(effects (font (size 0.7 0.7) (thickness 0.12)))
	)
	(fp_text value PogoEdge_1x01 (at 0 3.4) (layer F.Fab)
		(effects (font (size 0.5 0.5) (thickness 0.1)))
	)
	(pad 1 smd rect (at 0 0) (size 1.5 2.5) (layers F.Cu F.Mask))
	(fp_line (start -1.00 -1.50) (end 1.00 -1.50) (layer F.CrtYd) (width 0.05))
	(fp_line (start 1.00 -1.50) (end 1.00 1.50) (layer F.CrtYd) (width 0.05))
	(fp_line (start 1.00 1.50) (end -1.00 1.50) (layer F.CrtYd) (width 0.05))
	(fp_line (start -1.00 1.50) (end -1.00 -1.50) (layer F.CrtYd) (width 0.05))
)
