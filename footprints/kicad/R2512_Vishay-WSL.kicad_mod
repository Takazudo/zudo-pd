(module zudo-pd:R2512_Vishay-WSL (layer F.Cu) (tedit 6A300000)
	(descr "Vishay WSL datasheet doc 30100 (Revision 23-Nov-2023) page 2 solder pad dimensions, WSL2512 0.007 to 0.5 ohm row: a 0.065 in (1.65 mm) pad length, b 0.145 in (3.68 mm) pad width, l 0.160 in (4.06 mm) inner gap. Not fabrication-reviewed.")
	(attr smd)
	(fp_text reference REF** (at 0 -3.00) (layer F.SilkS)
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(fp_text value R2512_Vishay-WSL (at 0 3.00) (layer F.Fab)
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(fp_text user %R (at 0 0) (layer F.Fab)
		(effects (font (size 0.5 0.5) (thickness 0.08)))
	)
	(fp_line (start -3.175 -1.590) (end 3.175 -1.590) (layer F.Fab) (width 0.1))
	(fp_line (start 3.175 -1.590) (end 3.175 1.590) (layer F.Fab) (width 0.1))
	(fp_line (start 3.175 1.590) (end -3.175 1.590) (layer F.Fab) (width 0.1))
	(fp_line (start -3.175 1.590) (end -3.175 -1.590) (layer F.Fab) (width 0.1))
	(fp_line (start -1.700 -2.100) (end 1.700 -2.100) (layer F.SilkS) (width 0.12))
	(fp_line (start -1.700 2.100) (end 1.700 2.100) (layer F.SilkS) (width 0.12))
	(pad 1 smd rect (at -2.855 0) (size 1.650 3.680) (layers F.Cu F.Paste F.Mask))
	(pad 2 smd rect (at 2.855 0) (size 1.650 3.680) (layers F.Cu F.Paste F.Mask))
	(fp_line (start -3.93 -2.35) (end 3.93 -2.35) (layer F.CrtYd) (width 0.05))
	(fp_line (start 3.93 -2.35) (end 3.93 2.35) (layer F.CrtYd) (width 0.05))
	(fp_line (start 3.93 2.35) (end -3.93 2.35) (layer F.CrtYd) (width 0.05))
	(fp_line (start -3.93 2.35) (end -3.93 -2.35) (layer F.CrtYd) (width 0.05))
	(model "${KIPRJMOD}/../../footprints/kicad/zudo-pd.3dshapes/R2512_WSL_MaxEnvelope_L6.61-W3.44-H0.89.wrl"
		(offset (xyz 0 0 0))
		(scale (xyz 1 1 1))
		(rotate (xyz 0 0 0))
	)
)
